# Copy to .env and fill in before `docker compose up`.

# Postgres password for the "beacon" user/database created by the postgres service.
POSTGRES_PASSWORD=change-me

# Comma-separated hostnames the API accepts requests for, besides localhost — set this to
# whatever hostname colleagues will actually reach the deployment on (e.g. the domain in
# front of Caddy). Leave blank for local-only testing.
ALLOWED_HOSTS=

# Public hostname Caddy serves over HTTPS (and gets a certificate for). Leave as
# localhost for local dev, which makes Caddy use its own internal certificate.
CADDY_HOST=localhost

# Comma-separated list of email domains allowed to sign in via the magic-link login.
# A placeholder for now; narrow this to specific colleague addresses once known
# (see ui/server/src/auth.ts for the allowlist check).
ALLOWED_EMAIL_DOMAINS=northumbria.ac.uk

# Comma-separated sign-in emails that can see the Backups page and restore from it.
ADMIN_EMAILS=

# Base URL the magic-link email points back to. For local dev this is fine as-is;
# for a real deployment set this to the public https URL the reverse proxy serves.
MAGIC_LINK_BASE_URL=http://localhost

# "From" address on magic-link emails. Must be a sender verified in the SendGrid account
# (either a single verified sender, or a domain with SendGrid domain authentication set
# up) — SendGrid rejects sends from an address it hasn't verified.
EMAIL_FROM=beacon@localhost

# SendGrid API key for actually sending magic-link emails (Settings > API Keys in
# SendGrid; needs at least "Mail Send" permission). Leave blank during local development:
# emails are logged to the api/worker console instead of sent, so login still works
# without a real provider configured.
SENDGRID_API_KEY=

# Nightly backups to S3 (see deploy/backup/). Leave S3_BACKUP_BUCKET blank to disable backups
# (e.g. local development) — the backup container will idle and skip runs. Three things get
# written under the prefix below: db/<stamp>.sql.gz (a Postgres dump), programme/... (a live
# `aws s3 sync` mirror of the programme tree — content, assets, master video, theme, pipeline
# state), and manifest/<stamp>.json (a small {key: version-id} snapshot of programme/, used to
# restore the whole tree as of a past night). Point-in-time recovery for programme/ comes from
# S3 bucket versioning + a lifecycle rule, not from dated snapshots — run
# deploy/backup/setup-bucket.sh once against the bucket (with broader admin credentials, see
# below) BEFORE the backup container's first run, or its `aws s3 sync --delete` has no
# versioning safety net under it.
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=postgres
BACKUP_RETENTION_DAYS=14

# IAM user/role credentials for the nightly backup/restore container, scoped to the backup
# bucket (and its prefix) above: s3:PutObject, s3:GetObject, s3:GetObjectVersion, s3:ListBucket,
# s3:ListBucketVersions and s3:DeleteObject. Use a dedicated IAM user for this, not root account
# keys. deploy/backup/setup-bucket.sh is run separately, by hand, with broader/admin AWS
# credentials (s3:PutBucketVersioning, s3:PutLifecycleConfiguration) — it is one-time setup,
# not something the nightly container's own restricted credentials should be able to do.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
