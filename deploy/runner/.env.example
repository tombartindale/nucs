# Copy to .env beside docker-compose.yml and fill in before `docker compose up -d`.

# The server's public address (the same URL colleagues open in a browser).
NUCS_URL=https://nucs.example.org

# From Admin > Runners > Add a runner. One-time and valid for 24 hours; only read on the
# first start. Remove it from here once the runner shows as online.
RUNNER_REGISTRATION_TOKEN=

# Shown in Admin > Runners. Defaults to the container's hostname, which is not memorable.
RUNNER_NAME=studio-mac

# Jobs at once (each is one topic), and ffmpeg threads per job (blank: cores / slots).
RUNNER_SLOTS=2
RUNNER_THREADS=

# Only take these commands (comma-separated; blank takes any routed to runners), and the
# labels Admin > Runners can require (e.g. heavy).
RUNNER_COMMANDS=compose
RUNNER_LABELS=

# Container memory cap; about 1-1.5 GB per slot plus headroom.
RUNNER_MEMORY=8G

# No AWS keys here: the server issues each job temporary credentials limited to that job's
# own video and build outputs (deploy/RUNNER.md).

# Pin a specific build instead of latest, if the server is pinned.
# BEACON_IMAGE_TAG=sha-<commit>
